# Project URL de Supabase (Settings → API) — el mismo proyecto que usa backend/.env.
VITE_SUPABASE_URL=
# La key `anon`/`public` (NO la service_role — esa nunca debe llegar al frontend).
# RLS (backend/supabase/migrations/002_crm_rls.sql) es quien protege los datos: con la key
# anon sola, sin haber iniciado sesión como alguien en `team_members`, no se puede leer nada.
VITE_SUPABASE_ANON_KEY=
