PORT=4000
# Comma-separated list of allowed frontend origins (no trailing slash, no path — just
# scheme + host). Include your production domain(s) once deployed, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://sarkode.com,https://www.sarkode.com
CORS_ORIGIN=http://localhost:5173
# Required for the AI chat agent (POST /api/chat). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini. Set to whatever current model your account has access to.
OPENAI_MODEL=
# Optional — enables "schedule a call" inside the chat. Production URL of the Webhook node
# from backend/n8n/sarkode-schedule-call.workflow.json, after you import & activate it in n8n.
N8N_SCHEDULE_WEBHOOK_URL=
# Optional — leads and chat conversations are stored in Supabase. Project URL and
# service_role key from Settings → API in your Supabase project. Without these, leads
# fall back to a local backend/data/contacts.jsonl file and no conversations are saved.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — emails sofimh1197@gmail.com whenever a new lead is saved. Production URL of the
# Webhook node from backend/n8n/sarkode-new-lead-notification.workflow.json, after you import
# & activate it in n8n.
N8N_LEAD_NOTIFICATION_WEBHOOK_URL=
